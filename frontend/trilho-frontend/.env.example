# Copie para .env.local e ajuste.
#
# URL base da API .NET (Trilho.Api). Use a porta do perfil "http" do launchSettings.json.
# Sem esta variável, o front roda em MODO DEMONSTRAÇÃO (dados e login simulados) —
# o modo demonstração é ignorado em produção.
API_URL=http://localhost:5018

# Força o modo demonstração mesmo com API_URL definida (útil para apresentar sem o backend no ar).
# USE_MOCK_API=true
