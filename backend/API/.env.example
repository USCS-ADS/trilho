# Copie para ".env" (não versionado) antes de: docker compose --profile full up -d --build
MYSQL_ROOT_PASSWORD=troque-esta-senha-do-mysql
# Mínimo 32 caracteres, aleatória
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
SEED_ADMIN_EMAIL=admin@trilho.local
SEED_ADMIN_PASSWORD=troque-a-senha-do-admin
# Origem do front (CORS) e base pública da API (URL dos webhooks)
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000

# E-mail (convite e redefinição de senha). Log = só registra no log; Smtp = envio real.
EMAIL_PROVIDER=Log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Logins por minuto por IP (padrão 10). Com o front na Vercel suba para ~120.
AUTH_PERMIT_LIMIT=10
