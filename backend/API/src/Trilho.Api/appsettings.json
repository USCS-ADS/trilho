{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Connection": ""
  },
  "Settings": {
    "Jwt": {
      "SigningKey": "",
      "ExpiresMinutes": 1000,
      "Issuer": "trilho-api",
      "Audience": "trilho-app"
    },
    "AllowedOrigins": [],
    "SeedAdmin": {
      "Name": "Administrador",
      "Email": "",
      "Password": ""
    },
    "FrontendBaseUrl": "http://localhost:3000",
    "Invite": {
      "ExpiresDays": 7
    },
    "PasswordReset": {
      "ExpiresMinutes": 15,
      "MaxAttempts": 5
    },
    "Email": {
      "Provider": "Log",
      "LogBody": false,
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UserName": "",
        "Password": "",
        "EnableSsl": true,
        "FromAddress": "",
        "FromName": "Trilho"
      }
    },
    "RateLimiting": {
      "AuthPermitLimit": 10,
      "WebhookPermitLimit": 600
    },
    "SprintLengthDays": 14,
    "SprintAnchorDate": "2026-08-03",
    "UseForwardedHeaders": false,
    "Retention": {
      "GitEventsDays": 30,
      "AuthFlowDays": 7,
      "IntervalHours": 24
    },
    "PublicApiBaseUrl": "",
    "DataProtectionKeysPath": "",
    "Git": {
      "MaxAttempts": 5,
      "RetryIntervalSeconds": 60
    },
    "Notifications": {
      "DueSoonHours": 48,
      "DueSoonCheckMinutes": 60
    },
    "Workload": {
      "TasksPerMember": 8,
      "AlertThresholdPercent": 85
    }
  }
}
