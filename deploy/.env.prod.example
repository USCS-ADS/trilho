# Copie para "deploy/.env" NA VM (esse arquivo NUNCA vai para o Git) e preencha.
# Regras para os valores: sem aspas, sem espaços e, nas senhas, evite os caracteres  $  ;  "  e  #  (quebram o Compose ou a connection string).

# --- Imagem da API (GitHub Container Registry). Para a branch de teste use ...:sha-XXXXXXX
API_IMAGE=ghcr.io/uscs-ads/trilho-api:latest

# --- Endereço público da API (o Caddy emite o certificado para este host) — sem "https://"
API_HOST=trilho-api.exemplo.cloudapp.azure.com

# --- MySQL gerenciado (Azure Database for MySQL Flexible Server)
DB_HOST=seu-servidor.mysql.database.azure.com
DB_PORT=3306
DB_NAME=trilhodb
DB_USER=usuario_admin_do_mysql
DB_PASSWORD=troque-esta-senha

# --- Segurança da aplicação (gere valores NOVOS; nunca reaproveite os de desenvolvimento)
# Mínimo 32 caracteres, aleatória (ex.: 48 caracteres de letras e números)
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# --- Front (Vercel): origem permitida e base dos links enviados por e-mail
FRONTEND_ORIGIN=https://seu-projeto.vercel.app
FRONTEND_BASE_URL=https://seu-projeto.vercel.app

# --- Logins por minuto por IP (padrão da API: 10). Com o front na Vercel todos chegam pelo mesmo IP.
AUTH_PERMIT_LIMIT=120

# --- E-mail (convite e redefinição de senha). Log = só registra no log; Smtp = envio real.
EMAIL_PROVIDER=Log
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Trilho
